// Rule L2: the GLSL spellings 1.x accepted, written as HLSL.
Shader(Name="DreamShaderTests/Migrate/M_MgGlsl")
{
    Properties = {
        vec3 A = vec3(1.0, 0.0, 0.0);
        vec3 B = vec3(0.0, 0.0, 1.0);
        float T = 0.25;
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        vec3 Mixed = mix(A, B, T);
        Color = fract(Mixed * 4.0) + mod(Mixed, 0.5);
    }
}
