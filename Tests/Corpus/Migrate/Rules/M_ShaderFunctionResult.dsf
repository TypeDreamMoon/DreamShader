// A first output named Result is the return value; the others are `out` parameters, in 1.x order.
ShaderFunction(Name="DreamShaderTests/Migrate/MF_MgResult")
{
    Inputs = {
        vec3 InColor;
    }

    Outputs = {
        vec3 Result;
        float Weight;
    }

    Settings = {
        Description = "Returns the colour and its weight.";
        ExposeToLibrary = true;
        LibraryCategories = "DreamShader|Tests";
    }

    Graph = {
        Result = InColor * 0.5;
        Weight = dot(InColor, vec3(0.299, 0.587, 0.114));
    }
}
