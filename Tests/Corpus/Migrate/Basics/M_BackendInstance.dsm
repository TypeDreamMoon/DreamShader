// `Backend = "Instance"` is the old name of ThinCustom.
Shader(Name="DreamShaderTests/Migrate/M_MgBackend")
{
    Settings = {
        Backend = "Instance";
        ShadingModel = "Unlit";
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Color = vec3(1.0, 0.5, 0.25);
    }
}
