// `import` becomes `#include`, and the header's 1.x functions are still callable from the migrated file.
import "MigrateShared.dsh";

Shader(Name="DreamShaderTests/Migrate/M_MgImport")
{
    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        vec3 Tinted;
        ApplyTint(vec3(1.0, 1.0, 1.0), vec3(1.0, 0.5, 0.25), Tinted);
        Color = Tinted * Luma(Tinted);
    }
}
