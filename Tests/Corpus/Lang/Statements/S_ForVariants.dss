// `for` shapes and single-statement bodies.

export float ForVariants(float A)
{
    float Sum = 0.0;

    for (int i = 0; i < 4; ++i)         // declaration init
    {
        Sum += A;
    }

    int j = 0;
    for (j = 0; j < 4; j++)             // expression init
    {
        Sum += A;
    }

    for (;;)                            // all three parts empty
    {
        break;
    }

    for (int k = 0; ; ++k)              // no condition
    {
        if (k > 2)
        {
            break;
        }
    }

    for (int n = 3; n > 0; )            // no step
    {
        n = n - 1;
    }

    for (int p = 0; p < 2; ++p)         // single-statement body
        Sum += 1.0;

    if (A > 0.0)                        // single-statement if / else
        Sum += 1.0;
    else
        Sum -= 1.0;

    while (Sum > 100.0)                 // single-statement while
        Sum -= 1.0;

    while (Sum < 0.0)                   // empty block body
    {
    }

    return Sum;
}
