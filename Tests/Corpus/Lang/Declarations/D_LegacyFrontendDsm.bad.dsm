// A `.dsm` asks for the 1.x front end, and it gets it: the Auto front end sends this file to
// the legacy parser instead of answering DSH2199. The legacy parser holds it to the 1.x rules, and a block word
// without its `(Name = "...")` attribute list is DSH2241. This fixture pins the front-end selection, which is
// why it lives in the Lang layer and not in Legacy/Parse.

Shader M_Legacy
{
    Properties
    {
        float Intensity = 1.0;
    }

    Graph
    {
        EmissiveColor = Intensity;
    }
}
