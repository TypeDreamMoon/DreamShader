// A layer blend's inputs arrive THROUGH pins, so reading a field off one is GetMaterialAttributes. Nothing arrives
// through its `inout material`: the result starts empty, so what the blend writes is one MakeMaterialAttributes.

/// @layerblend
export void B_LayerBlend(material A, material B, inout material R)
{
    R.BaseColor = A.BaseColor;
    R.Roughness = B.Roughness;
}
