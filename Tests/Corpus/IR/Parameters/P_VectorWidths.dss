// CONTRACT 6.13 #22: every vector uniform is a VectorParameter (a float4 node) plus a Swizzle that
// narrows it -- float2 gets `xy`, float3 gets `xyz`, float4 gets no swizzle at all. One rule, so the
// emitter never has to ask how wide the author declared the parameter.

uniform float2 Pair = float2(1, 1);
uniform float3 Triple = float3(1, 0, 0);
uniform float4 Quad = float4(1, 1, 1, 1);

export void M_VectorWidths(inout material m)
{
    m.BaseColor = Triple;
    m.EmissiveColor = Quad.rgb;
    m.Opacity = Pair.x;
    m.Normal = float3(Pair, 1);
}
