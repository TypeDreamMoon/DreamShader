// Batch 2, debt B6 (i): an `if` decided at run time over Substrate values has no graph form -- the
// StaticSwitch is the only node that switches a Substrate value -- so it is refused with a message that
// names the type (DSH4378) rather than lowered to a float1 Select.

uniform bool Enabled = true;

export void M_B6_SubstrateDynamicIf(inout material m)
{
    Substrate Front = Substrate.Unlit(EmissiveColor = float3(0, 0.5, 1));
    if (Enabled)
    {
        Front = Substrate.Unlit(EmissiveColor = float3(1, 0.5, 0));
    }
    m.FrontMaterial = Front;
}
