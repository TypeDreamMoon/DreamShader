// A class with more than one output is a value of type `Node`; an output is picked by member
// access (decision 11 #1(b)).

export void M_NodeOutputs(inout material m)
{
    m.EmissiveColor = UE.SceneTexture(SceneTextureId = PostProcessInput0).Color.rgb;
    m.Opacity = UE.SceneTexture(SceneTextureId = PostProcessInput0).InvSize.x;
}
