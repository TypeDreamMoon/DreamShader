// CONTRACT 6.13 #35: the catalog carries Aliases on pins and properties, so the 1.x argument
// spellings keep working -- `Index` is `CoordinateIndex` and `UV` is `Coordinates`. The binder
// resolves them to the canonical names, so nothing downstream ever sees the alias; the two calls
// below are therefore the same node and the dedupe pass merges them.

export void M_LegacyArgumentNames(inout material m)
{
    float2 Legacy = UE.TexCoord(Index = 0);
    float2 Canonical = UE.TexCoord(CoordinateIndex = 0);
    m.EmissiveColor = float3(Legacy + Canonical, 0);
}
