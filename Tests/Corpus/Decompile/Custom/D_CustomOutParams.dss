// A void @custom with two outs: the first out is the node's primary output, the second an additional one.
/// @custom
void SplitColour(float4 V, out float3 Head, out float Tail)
{
    Head = V.rgb;
    Tail = V.a;
}

export void M_DCustomOutParams(inout material m)
{
    float3 H;
    float T;
    SplitColour(float4(1, 0.5, 0.25, 0.75), H, T);
    m.EmissiveColor = H;
    m.Opacity = T;
}
