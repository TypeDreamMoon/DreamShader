// One @custom calling another: the callee travels inside the caller's code as a wrapper struct member, and comes
// back as a function of its own.
/// @custom
float Luma(float3 Colour)
{
    return dot(Colour, float3(0.299, 0.587, 0.114));
}

/// @custom
float3 Desaturate(float3 Colour, float Amount)
{
    float L = Luma(Colour);
    return lerp(Colour, float3(L, L, L), Amount);
}

export void M_DCustomHelpers(inout material m)
{
    m.EmissiveColor = Desaturate(float3(1, 0.5, 0.25), 0.5);
}
