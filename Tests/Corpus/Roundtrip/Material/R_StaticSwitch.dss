// A static bool and its switch.
#pragma material(ShadingModel = Unlit, BlendMode = Opaque)

/// @static
/// @group Look
uniform bool UseWarm = true;

export void M_RtStaticSwitch(inout material m)
{
    float3 Colour = float3(0, 0.5, 1);
    if (UseWarm)
    {
        Colour = float3(1, 0.5, 0);
    }
    m.EmissiveColor = Colour;
}
