// Rule L5: a receiver is a variable (DSH4239).
Function float Halve(in float value) { return value * 0.5; }

Shader(Name="M_LiReceiverNotVariable")
{
    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Halve(1.0, 2.0);
        Color = vec3(1.0, 1.0, 1.0);
    }
}
