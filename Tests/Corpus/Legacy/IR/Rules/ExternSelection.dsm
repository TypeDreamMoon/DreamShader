// Rule L3b: selections over a VirtualFunction call. After the passes there is ONE FunctionCall node: `x` reads output 1,
// `y` output 0, and the value call `z` output 0 -- with no DSH4217 for the `out`s a value call leaves out.
VirtualFunction(Name="MF_LiSplit")
{
    Options = {
        Asset = Path(Game, "Functions/MF_LiSplit");
    }

    Inputs = {
        float3 Colour;
        opt float Gain = 1.0;
    }

    Outputs = {
        float3 A;
        float B;
    }
}

Shader(Name="M_LiExternSelection")
{
    Outputs = {
        vec3 Color;
        float Alpha;
        Base.EmissiveColor = Color;
        Base.Opacity = Alpha;
    }

    Graph = {
        vec3 i = vec3(1.0, 0.5, 0.25);
        float x = MF_LiSplit(i, Output = "B");
        vec3 y = MF_LiSplit(i, OutputIndex = 0);
        vec3 z = MF_LiSplit(i);
        Color = y + z;
        Alpha = x;
    }
}
