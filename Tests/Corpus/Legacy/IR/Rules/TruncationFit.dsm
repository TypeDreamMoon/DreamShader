// Rule L22: a value wider than the place it goes is cut down to its leading components -- an initializer, an assignment,
// an argument -- as the 1.x generator fitted it (CoerceValueToType). Said with an Info (DSH5289); the migrator writes `.rgb`.
Function float Luma(in vec3 colour) { return dot(colour, vec3(0.299, 0.587, 0.114)); }

Shader(Name="M_LiTruncation")
{
    Properties = {
        ScalarParameter Gain = 0.5;
        VectorParameter Tint = float4(1.0, 0.5, 0.25, 1.0);
        vec3 V = vec3(1.0, 2.0, 3.0);
    }

    Outputs = {
        vec3 Color;
        float Alpha;
        Base.EmissiveColor = Color;
        Base.Opacity = Alpha;
    }

    Graph = {
        vec3 Narrow = Tint;
        Color = Tint;
        Alpha = Luma(Tint);
        Color = Color * Narrow;
    }
}
