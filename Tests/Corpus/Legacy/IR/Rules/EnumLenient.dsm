// Rule L12: `SAMPLERTYPE_Normal` and `normal` both mean the catalog's `Normal` (DSH5278 each).
Shader(Name="M_LiEnum")
{
    Properties = {
        TextureObjectParameter Source;
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        float2 uv = UE.TexCoord(Index = 0);
        vec3 First = UE.Expression(Class="TextureSample", TextureObject=Source, Coordinates=uv, SamplerType=SAMPLERTYPE_Normal, OutputIndex=0);
        vec3 Second = UE.Expression(Class="TextureSample", TextureObject=Source, Coordinates=uv, SamplerType=normal, OutputIndex=0);
        Color = First + Second;
    }
}
