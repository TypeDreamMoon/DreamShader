// Rule L10: a 1.x block keeps its 1.x destination. Golden review: product `legacy root "Plugin.Foo"`, name `Dir/M_LiDest`.
Shader(Name="Dir/M_LiDest", Root="Plugin.Foo")
{
    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Color = vec3(1.0, 0.5, 0.25);
    }
}
