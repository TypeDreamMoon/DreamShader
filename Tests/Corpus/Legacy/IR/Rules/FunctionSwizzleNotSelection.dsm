// `F(x).rgb` on a function that returns a float3 is a swizzle, not an output selection.
Function vec3 Shade(in vec3 color) { return color * 0.5; }

Shader(Name="M_LiFunctionSwizzle")
{
    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Color = Shade(vec3(1.0, 0.5, 0.25)).bgr;
    }
}
