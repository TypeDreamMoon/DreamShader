// One file, one Shader.
Shader(Name="M_LpFirstOfTwo")
{
    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Color = vec3(1.0, 0.5, 0.25);
    }
}

Shader(Name="M_LpSecondOfTwo")
{
    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Color = vec3(1.0, 0.5, 0.25);
    }
}
