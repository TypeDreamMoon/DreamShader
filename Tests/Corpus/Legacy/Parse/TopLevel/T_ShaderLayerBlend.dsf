// A ShaderLayerBlend: its material inputs in order, then the result.
ShaderLayerBlend(Name="Layers/MLB_LpOverlay")
{
    Properties = {
        float Alpha = 0.5;
    }

    Inputs = {
        MaterialAttributes Bottom;
        MaterialAttributes Top;
    }

    Outputs = {
        MaterialAttributes Attrs;
    }

    Graph = {
        Attrs.BaseColor = lerp(Bottom.BaseColor, Top.BaseColor, Alpha);
    }
}
