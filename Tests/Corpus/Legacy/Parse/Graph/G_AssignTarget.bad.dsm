// The left of an assignment is a variable or `variable.member`.
Shader(Name="M_LpGAssignTarget")
{
    Properties = {
        float A = 1.0;
        vec3 V = vec3(1.0, 2.0, 3.0);
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        A * 2.0 = 1.0;
        Color = V;
    }
}
