// `#Region` needs a name.
Shader(Name="M_LpGRegionNoName")
{
    Properties = {
        float A = 1.0;
        vec3 V = vec3(1.0, 2.0, 3.0);
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        #Region
        Color = V;
        #EndRegion
    }
}
