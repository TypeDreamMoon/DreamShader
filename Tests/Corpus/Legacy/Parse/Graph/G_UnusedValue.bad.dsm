// An expression statement whose value is unused.
Shader(Name="M_LpGUnusedValue")
{
    Properties = {
        float A = 1.0;
        vec3 V = vec3(1.0, 2.0, 3.0);
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        A * 2.0;
        Color = V;
    }
}
