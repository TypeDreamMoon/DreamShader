// An assignment inside an expression.
Shader(Name="M_LpGAssignInExpression")
{
    Properties = {
        float A = 1.0;
        vec3 V = vec3(1.0, 2.0, 3.0);
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        float C;
        float D = (C = A);
        Color = V * D;
    }
}
