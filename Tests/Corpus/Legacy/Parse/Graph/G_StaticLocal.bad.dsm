// `static` / `const` on a Graph variable.
Shader(Name="M_LpGStaticLocal")
{
    Properties = {
        float A = 1.0;
        vec3 V = vec3(1.0, 2.0, 3.0);
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        const float C = 2.0;
        Color = V * C;
    }
}
