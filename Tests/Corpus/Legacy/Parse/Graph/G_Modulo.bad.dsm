// A modulo operator; the message points at `.dss`.
Shader(Name="M_LpGModulo")
{
    Properties = {
        float A = 1.0;
        vec3 V = vec3(1.0, 2.0, 3.0);
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        float C = A % 2.0;
        Color = V * C;
    }
}
