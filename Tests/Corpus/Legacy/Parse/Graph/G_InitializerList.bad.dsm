// A braced ASSIGNMENT. (A braced declaration, `vec3 C = { 1.0, 2.0, 3.0 };`, is the constructor `vec3(...)`, as it
// was in 1.x; an assignment would need the target's type, which the parser does not have, and the expression grammar
// refuses a list anywhere but an initializer: DSH2162.)
Shader(Name="M_LpGInitializerList")
{
    Properties = {
        float A = 1.0;
        vec3 V = vec3(1.0, 2.0, 3.0);
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        vec3 C;
        C = { 1.0, 2.0, 3.0 };
        Color = C;
    }
}
