// A local without an initializer is zero of its exact width in 1.x; the front end writes the zero (SynthesizedInitializers).
Shader(Name="M_LpGZero")
{
    Properties = {
        float A = 1.0;
        vec3 V = vec3(1.0, 2.0, 3.0);
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        float S;
        vec2 P;
        vec3 Q;
        vec4 R;
        Color = Q + vec3(S, P.x, R.a);
    }
}
