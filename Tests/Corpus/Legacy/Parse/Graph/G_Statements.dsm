// Every statement form a 1.x Graph had: declarations, assignments, member writes, calls, `if` / `else` with one comparison, regions.
Shader(Name="M_LpGStatements")
{
    Properties = {
        float A = 1.0;
        vec3 V = vec3(1.0, 2.0, 3.0);
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        float Local = A * 2.0;
        vec3 Tinted = V * Local;
        Tinted.x = 0.5;
        #Region "Branch"
        if (A > 0.5) {
            Color = Tinted;
        } else {
            Color = vec3(0.0, 0.0, 0.0);
        }
        #EndRegion
        float t = UE.Time();
        Color = Color * sin(t);
    }
}
