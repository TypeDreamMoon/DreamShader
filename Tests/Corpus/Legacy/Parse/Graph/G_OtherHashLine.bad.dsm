// A `#` line other than the region pair.
Shader(Name="M_LpGOtherHashLine")
{
    Properties = {
        float A = 1.0;
        vec3 V = vec3(1.0, 2.0, 3.0);
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        #define X 1
        Color = V;
    }
}
