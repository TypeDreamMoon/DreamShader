// A texture variable without an initializer has no zero.
Shader(Name="M_LpGTextureNoInitializer")
{
    Properties = {
        float A = 1.0;
        vec3 V = vec3(1.0, 2.0, 3.0);
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Texture2D T;
        Color = V;
    }
}
