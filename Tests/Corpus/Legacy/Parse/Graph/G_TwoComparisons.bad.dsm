// More than one comparison in a condition.
Shader(Name="M_LpGTwoComparisons")
{
    Properties = {
        float A = 1.0;
        vec3 V = vec3(1.0, 2.0, 3.0);
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        if (A > 0.5 && A < 0.75) {
            Color = V;
        }
    }
}
