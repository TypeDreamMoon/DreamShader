// A comment's Color is a vector literal.
Shader(Name="M_LpLayoutColor")
{
    Layout = {
        Comment(Name="Box", X=0, Y=0, W=100, H=100, Color="red");
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Color = vec3(1.0, 0.5, 0.25);
    }
}
