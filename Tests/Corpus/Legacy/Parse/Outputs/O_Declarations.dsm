// Output declarations become zero-initialised locals of the entry; `Base.X = src;` keeps its spelling on the material.
Shader(Name="M_LpOutputs")
{
    Outputs = {
        vec3 Color;
        float Alpha;
        vec2 Pair;
        Base.EmissiveColor = Color;
        Base.Opacity = Alpha;
    }

    Graph = {
        Color = vec3(1.0, 0.5, 0.25);
        Alpha = 0.5;
        Pair = vec2(0.0, 1.0);
    }
}
