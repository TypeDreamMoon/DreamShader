// A scalar default or slider bound written with an exponent is a number, as 1.x read it.
Shader(Name="M_LpExponent")
{
    Properties = {
        ScalarParameter Range = 1e3 [Slider(0, 2.5E+3)];
        float Falloff = 2.5e-1f;
        const float Bias = -1.5e2;
    }

    Outputs = {
        float Alpha;
        Base.Opacity = Alpha;
    }

    Graph = {
        Alpha = Range * Falloff + Bias;
    }
}
