// A texture default is an asset reference, carried unresolved as `/// @default`.
Shader(Name="M_LpTextureDefault")
{
    Properties = {
        TextureObjectParameter Source = Path(Engine, "EngineResources/DefaultTexture");
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Color = SampleTexture2D(Source, UE.TexCoord(Index = 0)).rgb;
    }
}
