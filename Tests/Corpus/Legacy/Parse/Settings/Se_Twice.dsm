// A setting written twice: the later value, with a warning (DSH3262).
Shader(Name="M_LpSettingTwice")
{
    Settings = {
        BlendMode = "Opaque";
        BlendMode = "Translucent";
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Color = vec3(1.0, 0.5, 0.25);
    }
}
