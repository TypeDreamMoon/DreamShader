// A one-word value is written bare, anything else quoted; Backend is carried as written.
Shader(Name="M_LpSettings")
{
    Settings = {
        Domain = "Surface";
        ShadingModel = Unlit;
        BlendMode = "Translucent";
        TwoSided = true;
        OpacityMaskClipValue = 0.25;
        Backend = "Graph";
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Color = vec3(1.0, 0.5, 0.25);
    }
}
