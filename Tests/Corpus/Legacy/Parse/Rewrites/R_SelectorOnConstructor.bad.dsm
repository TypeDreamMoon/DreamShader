// A constructor has no outputs to select.
Shader(Name="M_LpRSelectorOnConstructor")
{
    Properties = {
        TextureObjectParameter Source;
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Color = vec3(1.0, 2.0, 3.0, OutputIndex = 0);
    }
}
