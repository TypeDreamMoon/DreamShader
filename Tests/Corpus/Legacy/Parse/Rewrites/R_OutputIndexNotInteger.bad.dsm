// `OutputIndex` is a whole number of zero or more.
Shader(Name="M_LpROutputIndexNotInteger")
{
    Properties = {
        TextureObjectParameter Source;
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Color = UE.VertexColor(OutputIndex = -1);
    }
}
