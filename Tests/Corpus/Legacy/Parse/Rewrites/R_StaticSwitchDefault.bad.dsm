// `Default` is `true` or `false`.
Shader(Name="M_LpRStaticSwitchDefault")
{
    Properties = {
        TextureObjectParameter Source;
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Color = UE.StaticSwitchParameter(Name = "UseWarm", Default = 2, True = vec3(1.0, 0.0, 0.0), False = vec3(0.0, 0.0, 1.0));
    }
}
