// A static switch is called with both inputs.
Shader(Name="M_LpRStaticSwitchOneInput")
{
    Properties = {
        TextureObjectParameter Source;
    }

    Outputs = {
        vec3 Color;
        Base.EmissiveColor = Color;
    }

    Graph = {
        Color = UE.StaticSwitchParameter(Name = "UseWarm", True = vec3(1.0, 0.0, 0.0));
    }
}
