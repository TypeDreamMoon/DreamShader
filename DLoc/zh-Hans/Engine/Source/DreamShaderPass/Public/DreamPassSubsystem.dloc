namespace UObjectToolTips

DreamPassApiActivation {
    at    Source/DreamShaderPass/Public/DreamPassSubsystem.h#DreamPassApiActivation
    src   "A pipeline activated through UDreamPassSubsystem::AddPipeline."
}

DreamPassHandle {
