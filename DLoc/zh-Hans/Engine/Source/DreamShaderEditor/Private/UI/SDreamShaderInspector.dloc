ProvenanceExplainGenerated {
    at    Source/DreamShaderEditor/Private/UI/SDreamShaderInspector.cpp
    src   "The asset holds exactly what DreamShader last generated into it. A source change rebuilds it freely."
    text  "此资产与 DreamShader 上次生成的内容完全一致。源文件变更会直接重建它。"
    state machine
}

ProvenanceExplainTweakedActions {
    at    Source/DreamShaderEditor/Private/UI/SDreamShaderInspector.cpp
    src   "The generated content still matches, and you have set parameter overrides on the instance. Rebuilds go ahead as normal and put your values back; a parameter the source no longer declares is dropped and named in the log. Adopt Tweaks writes the values into the source as defaults, and Extract Tweaks moves them into a .dsi instance."
    text  "生成的内容仍然一致，而你在实例上设置了参数覆盖。重建会照常进行，并把你的值放回去；源文件不再声明的参数会被丢弃，并在日志中列出。“采纳微调”会把这些值作为默认值写进源文件，“提取微调”会把它们移进一个 .dsi 实例。"
    state machine
}

ProvenanceExplainDiverged {
    at    Source/DreamShaderEditor/Private/UI/SDreamShaderInspector.cpp
    src   "The asset was edited by hand since it was generated, so a rebuild is refused to protect those edits. Decide which copy is the truth."
    text  "此资产在生成之后被手动编辑过,因此重建被拒绝,以保护这些修改。请决定以哪一份为准。"
    state machine
}

ProvenanceExplainUnstamped {
    at    Source/DreamShaderEditor/Private/UI/SDreamShaderInspector.cpp
    src   "Generated by DreamShader, but carrying no digest this version can compare. The next rebuild restamps it."
    text  "由 DreamShader 生成,但没有本版本能比对的指纹。下次重建会重新盖戳。"
    state machine
}

ProvenanceExplainForeign {
    at    Source/DreamShaderEditor/Private/UI/SDreamShaderInspector.cpp
    src   "Not generated by DreamShader. Export it to a source file to bring it under DreamShader's management."
    text  "不是 DreamShader 生成的。把它导出为源文件即可纳入 DreamShader 管理。"
    state machine
}

