}

CustomNeverReturns {
    at    Source/DreamShaderLang/Private/IR/IRCustomHlsl.cpp
    src   "'{0}' declares a return type but its body never returns a value; the node's first output will be 0."
    text  "'{0}' 声明了返回类型，但函数体从未返回值；节点的第一个输出将为 0。"
    state machine
}

CustomNoVerbatimBody {
