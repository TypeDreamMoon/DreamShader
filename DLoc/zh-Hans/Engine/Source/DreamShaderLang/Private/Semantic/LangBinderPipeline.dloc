FullscreenMaterialTooEarly {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "A fullscreen material pass needs the scene textures, which do not exist yet at {0}; run '{1}' at AfterBasePass or later."
    text  "全屏材质 Pass 需要场景纹理，而它们在 {0} 还不存在；请在 AfterBasePass 或更晚的注入点运行 '{1}'。"
    state machine
}

MeshAtBeginView {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "A mesh pass draws primitives against a view that has no depth yet at BeginView; run '{0}' at BeforeBasePass or later."
    text  "网格 Pass 要在视图上绘制图元，而视图在 BeginView 还没有深度；请在 BeforeBasePass 或更晚的注入点运行 '{0}'。"
    state machine
}

MeshAtEndOfView {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "At EndOfView the view is at output resolution and has no depth to draw primitives against; run mesh pass '{0}' earlier."
    text  "在 EndOfView，视图处于输出分辨率，也没有可供绘制图元时测试的深度；请让网格 Pass '{0}' 更早运行。"
    state machine
}

FullscreenMaterialUnverified {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "A fullscreen material pass at {0} has not been verified on this engine yet; BeforePostProcess is the point it is known to work at."
    text  "位于 {0} 的全屏材质 Pass 尚未在此引擎上验证过；已知能正常工作的注入点是 BeforePostProcess。"
    state machine
}

SlotPassBeginView {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "At BeginView the scene textures do not exist yet: the SceneTextures pass '{0}' sees are placeholders. Its 'View' holds the camera -- transforms, position, view rect, time -- but nothing the renderer adds later: no sky or atmosphere, PreExposure 1, and last frame's transforms equal this frame's."
    text  "在 BeginView，场景纹理还不存在：Pass '{0}' 看到的 SceneTextures 只是占位内容。它的 'View' 包含相机数据——变换矩阵、位置、视口矩形、时间——但不含渲染器之后才填的内容：没有天空和大气，PreExposure 为 1，上一帧的变换等于本帧的。"
    state machine
}

FullscreenShaderBeforeBasePass {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "At BeforeBasePass only scene depth exists: the other scene textures pass '{0}' could read are placeholders."
    text  "在 BeforeBasePass 只有场景深度存在：Pass '{0}' 能读取的其他场景纹理都只是占位纹理。"
    state machine
}

MeshBeforeBasePassTestScene {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "At BeforeBasePass scene depth holds what the depth prepass drew, which may not be everything; mesh pass '{0}' is meant to run there with 'Depth = None' or 'Depth = Own(...)'."
    text  "在 BeforeBasePass，场景深度只包含深度预通道绘制的内容，未必是全部；网格 Pass '{0}' 在那里运行时应使用 'Depth = None' 或 'Depth = Own(...)'。"
    state machine
}

MeshAfterUpscaleCopied {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "At {0} the view is upscaled and scene depth is still at render resolution; mesh pass '{1}' tests against it, or against a copy of it brought into the pixels of outputs of another size, so its depth test is only as fine as the render resolution."
    text  "在 {0}，视图已经放大，而场景深度仍是渲染分辨率；网格 Pass '{1}' 针对它做深度测试，或针对一份换算到其他尺寸输出像素上的副本做测试，因此它的深度测试精度只能达到渲染分辨率。"
    state machine
}

ReadAndWrite {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "Pass '{0}' reads and writes '{1}', and one pass cannot have one texture as its input and its output; write another buffer, or read '{1}.Previous' of a 'History = true' buffer."
    text  "Pass '{0}' 同时读取和写入 '{1}'，而一个 Pass 不能把同一张纹理既当输入又当输出；请写入另一个缓冲，或读取 'History = true' 缓冲的 '{1}.Previous'。"
    state machine
}

MeshSceneAndOwnTargets {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "Mesh pass '{0}' writes '{1}', a texture of the scene, together with '{2}', a buffer of the pipeline. A mesh pass draws all its targets through one viewport, so they have to be one size holding the view at one place; the scene's textures are usually larger than the view they hold (rounded up, and in the editor grown to the largest view so far) while a buffer is the view's size, and the runtime skips the pass whenever the two differ. Write them in two mesh passes."
    text  "网格 Pass '{0}' 同时写入场景纹理 '{1}' 和管线缓冲 '{2}'。网格 Pass 通过同一个视口绘制它的所有目标，因此这些目标必须尺寸相同，且视图在其中的位置相同；场景纹理通常比其中的视图大（会向上取整，在编辑器中还会增长到迄今最大的视图尺寸），而缓冲与视图一样大，两者不一致时运行时就会跳过这个 Pass。请用两个网格 Pass 分别写入它们。"
    state machine
}

MeshSizesDiffer {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "The outputs of mesh pass '{0}' are drawn together and have one size: '{1}' is {2}, and '{3}' is {4}."
    text  "网格 Pass '{0}' 的各个输出是一起绘制的，必须尺寸相同：'{1}' 是 {2}，而 '{3}' 是 {4}。"
    state machine
}

MeshOwnDepthSceneTargets {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "Mesh pass '{0}' writes '{1}', a texture of the scene, and tests against its own depth '{2}', which is bound from its corner: in a view that does not start at the corner of the scene's textures -- the second view of split screen, the right eye in stereo -- the depth does not reach the view's pixels, and the runtime skips the pass there."
    text  "网格 Pass '{0}' 写入场景纹理 '{1}'，并针对自身深度 '{2}' 做测试，而该深度是从其角点开始绑定的：在不从场景纹理角点开始的视图中——分屏的第二个视图、立体渲染的右眼——深度覆盖不到视图的像素，运行时会在那里跳过这个 Pass。"
    state machine
}

MeshOwnDepthSmaller {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "Mesh pass '{0}' tests against its own depth '{1}', which is {2}, and its outputs are {3}; an own depth is bound as it is, so it must be at least their size: give it their resolution and a scale no smaller than theirs, or a fixed size no smaller than theirs."
    text  "网格 Pass '{0}' 针对自身深度 '{1}' 做测试，它的尺寸是 {2}，而输出是 {3}；自身深度按原样绑定，因此至少要与输出一样大：请给它与输出相同的分辨率和不小于输出的缩放比例，或不小于输出的固定尺寸。"
    state machine
}

SceneColorResolution {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "Pass '{0}' writes scene colour, which is {1} at {2}, and '{3}' with it, which is {4}; targets drawn together have one size."
    text  "Pass '{0}' 写入场景颜色（它在 {2} 的尺寸是 {1}），同时还写入 '{3}'（尺寸是 {4}）；一起绘制的目标必须尺寸相同。"
    state machine
}

TwoTonemappers {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "Pass '{0}' replaces the tonemapper, and so does '{1}'; one view runs one tonemapper, so a pipeline replaces it at most once."
    text  "Pass '{0}' 替换了色调映射器，'{1}' 也替换了它；一个视图只运行一个色调映射器，因此一个管线最多只能替换它一次。"
