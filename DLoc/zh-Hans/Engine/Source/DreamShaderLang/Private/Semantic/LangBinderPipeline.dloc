    text  "读取"
    state machine
}

CustomStencilWrites {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "writes"
    text  "写入"
    state machine
}

CustomDepthAfterBasePass {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "'{0}' exists at AfterBasePass only when r.CustomDepth.Order draws custom depth before the base pass; where it does not, pass '{1}' reads a cleared placeholder. From AfterOpaque on it always exists."
    text  "只有当 r.CustomDepth.Order 让自定义深度在 BasePass 之前绘制时，'{0}' 才会在 AfterBasePass 存在；否则 Pass '{1}' 读到的是一张已清空的占位纹理。从 AfterOpaque 起它总是存在。"
    state machine
}

TranslucencyOnlyThere {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "'Translucency' exists on the post-process chain only (PostProcess.*), and pass '{1}' runs at {2}."
    text  "'Translucency' 只存在于后处理链上（PostProcess.*），而 Pass '{1}' 在 {2} 运行。"
    state machine
}

BuiltinNotYet {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "'{0}' does not exist yet at {2}, where pass '{1}' runs; it exists from {3} on."
    text  "'{0}' 在 {2} 还不存在，而 Pass '{1}' 在那里运行；它从 {3} 起才存在。"
    state machine
}

BuiltinNotWritableSceneColorTranslucency {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "'SceneColor' is read-only at PostProcess.TranslucencyAfterDOF, where pass '{1}' runs: the post-process chain carries the translucency there, so write 'Translucency', or write the scene colour at another point."
    text  "'SceneColor' 在 PostProcess.TranslucencyAfterDOF 是只读的，而 Pass '{1}' 正在那里运行：那里的后处理链承载的是半透明，因此请写入 'Translucency'，或在其他注入点写入场景颜色。"
    state machine
}

BuiltinNotWritableTranslucency {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "'Translucency' is written at PostProcess.TranslucencyAfterDOF only, and pass '{1}' runs at {2}; elsewhere on the chain it is read-only."
    text  "'Translucency' 只能在 PostProcess.TranslucencyAfterDOF 写入，而 Pass '{1}' 在 {2} 运行；在后处理链的其他位置它是只读的。"
    state machine
}

BuiltinNotWritable {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "'{0}' is the renderer's and pass '{1}' cannot write it at {2}; write a buffer of the pipeline instead."
    text  "'{0}' 属于渲染器，Pass '{1}' 不能在 {2} 写入它；请改为写入管线自己的缓冲。"
    state machine
}

SceneColorAfterBasePass {
    at    Source/DreamShaderLang/Private/Semantic/LangBinderPipeline.cpp
    src   "At AfterBasePass scene colour holds the emissive light only; nothing is lit yet, so pass '{0}' {1} that."
    text  "在 AfterBasePass，场景颜色只包含自发光；此时还没有任何光照，因此 Pass '{0}' {1}的就是这样的场景颜色。"
    state machine
}

