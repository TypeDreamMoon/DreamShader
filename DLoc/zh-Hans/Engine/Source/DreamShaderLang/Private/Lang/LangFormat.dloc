dloc 1
culture zh-Hans
namespace DreamShader.Format

FormatCheckComment {
    at    Source/DreamShaderLang/Private/Lang/LangFormat.cpp
    src   "the comment '{0}' is not in it"
    text  "其中没有注释 '{0}'"
    state machine
}

FormatCheckFailed {
    at    Source/DreamShaderLang/Private/Lang/LangFormat.cpp
    src   "The formatted text of '{0}' failed its own check -- {1} -- so nothing was written. This is a fault of the formatter, not of the file."
    text  "'{0}' 格式化后的文本没有通过自检 —— {1} —— 所以什么也没有写入。这是格式化器的问题，不是文件的问题。"
    state machine
}

FormatCheckParse {
    at    Source/DreamShaderLang/Private/Lang/LangFormat.cpp
    src   "it does not parse ({0})"
    text  "它无法解析（{0}）"
    state machine
}

FormatCheckStable {
    at    Source/DreamShaderLang/Private/Lang/LangFormat.cpp
    src   "formatting it again gives another text"
    text  "再格式化一次会得到另一份文本"
    state machine
